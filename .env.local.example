# Local Postgres (docker-compose)
DATABASE_URL=postgres://voxtree:voxtree_dev@localhost:5432/voxtree

# Auth.js — generate with: openssl rand -base64 32
# Required, minimum 32 characters: lib/env.ts fails closed at boot in
# production when AUTH_SECRET is missing, empty, or too short.
AUTH_SECRET=
# Optional dedicated salt for consent audit digests; falls back to
# AUTH_SECRET when unset. In production one of the two must be set.
# CONSENT_HASH_SALT=
# Google OAuth (optional — provider + login button are disabled when unset)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_FAMILY_MONTHLY_PRICE_ID=price_...
STRIPE_FAMILY_ANNUAL_PRICE_ID=price_...
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_ANNUAL_PRICE_ID=price_...
# Pilot price ($29.99/month — decided Oct 29, 2026). Create it with:
#   STRIPE_SECRET_KEY=sk_test_... node scripts/stripe-bootstrap-pilot.mjs
# then paste the printed price_... here. Test-mode IDs only work with
# test keys; re-run the bootstrap with the live key for production.
STRIPE_PILOT_PRICE_ID=price_...

# Transactional email (Resend) — used by lib/email.ts sendEmail for
# direct sends such as the waitlist confirmation email. Optional:
# without RESEND_API_KEY those sends are a logged no-op and signups
# still succeed. EMAIL_FROM must use a domain verified in Resend
# (e.g. the production domain once its DNS records are added).
RESEND_API_KEY=re_...
EMAIL_FROM="VoxTree <hello@vox-tree.com>"

# Voice — self-hosted SeedVC service (see workers/seedvc/README.md)
# Optional; defaults to http://localhost:8001 when unset.
SEEDVC_SERVICE_URL=http://localhost:8001

# Replicate
REPLICATE_API_TOKEN=your-replicate-api-token
REPLICATE_WEBHOOK_SECRET=your-replicate-webhook-secret

# Google Cloud Storage (GCS)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_CLIENT_EMAIL=your-service-account-email
GOOGLE_CLOUD_PRIVATE_KEY="your-private-key"
GCS_BUCKET_NAME=voxtree-media

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development only. Simulation is always rejected in production.
SIMULATION_MODE=false

# Advanced features remain off until separately approved for launch.
FEATURE_VISUAL_CLONING=false
FEATURE_SINGING_VOICE=false
FEATURE_TALKING_VIDEO=false

# Optional incident destination (Slack-compatible or internal webhook).
ALERT_WEBHOOK_URL=
TRANSACTIONAL_EMAIL_WEBHOOK_URL=
